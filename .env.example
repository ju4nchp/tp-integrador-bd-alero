# Variables que usa docker-compose.yml (todas tienen un valor por defecto)
MYSQL_ROOT_PASSWORD=root
MONGO_USER=admin
MONGO_PASSWORD=admin

# Motor que usa el backend si el pedido no trae el header X-DB-Engine: mysql | mongo
MOTOR_POR_DEFECTO=mysql

# Puertos del host (cambiarlos si ya hay algo escuchando ahi)
MYSQL_PUERTO=3306
MONGO_PUERTO=27017
PHPMYADMIN_PUERTO=8081
